---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid from '../../components/PostGrid.astro';
import { type Category, CATEGORIES, CATEGORY_LABELS, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
	return CATEGORIES.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as Category;
const posts = await getPosts(category);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${CATEGORY_LABELS[category]} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<PostGrid posts={posts} />
			</section>
		</main>
		<Footer />
	</body>
</html>
